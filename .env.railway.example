SPRING_PROFILES_ACTIVE=prod

# Issuer público do NimbusAuth (enviado ao browser em /oauth2/authorize) - mesmo domínio já usado
# pelo CardsyncServer/CardSyncWeb.
NIMBUS_AUTH_ISSUER=https://auth.nimbussystems.com.br

# NÃO USADA em produção (ver application-prod.yml) - token/jwk-set/user-info/nimbusauth.base-url
# usam NIMBUS_AUTH_ISSUER (URL pública), mesmo padrão do CardsyncServer. A ideia original era usar
# a rede privada do Railway aqui pra chamadas backend->backend (mais rápido, não passa pela
# Cloudflare), mas isso nunca funcionou de fato em produção (hostname/porta interno incorretos ou
# private networking não habilitado entre os serviços) - toda chamada de token/jwk-set/user-info
# falhava (502/504 em /bff/v1/me/profile). Só usada localmente (default http://localhost:9090 em
# application-dev.yml) - fica aqui só como referência caso alguém reative a rede privada no futuro.
NIMBUS_AUTH_INTERNAL_BASE_URL=http://nimbus-auth.railway.internal:8080

# Secret compartilhado da API interna machine-to-machine do NimbusAuth (/internal/users, ver
# NimbusAuthInternalClient/UserDirectoryService) - resolve nome de usuário pra "solicitado
# por"/"aprovado por" em Aditivo/etc. Precisa ser IDÊNTICO ao NIMBUS_INTERNAL_API_SECRET já
# configurado no serviço do NimbusAuth no Railway (mesmo valor usado pelo CardsyncServer).
NIMBUS_INTERNAL_API_SECRET=change-me

NIMBUSNOVAX_BFF_CLIENT_ID=nimbusnovax-bff
# Precisa ser IDÊNTICO ao NIMBUSNOVAX_BFF_CLIENT_SECRET setado no serviço do NimbusAuth.
NIMBUSNOVAX_BFF_CLIENT_SECRET=change-me

# Domínio PAI compartilhado com a SPA (não o do próprio NimbusNovaxServer!) - obrigatório, sem
# default. Mesmo motivo documentado no CardsyncServer: o cookie XSRF-TOKEN precisa ser legível via
# document.cookie pelo JS da SPA (novax.nimbussystems.com.br), o que só funciona se o Domain do
# cookie cobrir os dois hosts - usar o host específico do backend aqui (novax-api...) quebra todo
# POST/PUT/PATCH/DELETE da SPA em produção com 403 "Invalid CSRF Token 'null'".
NIMBUSNOVAX_COOKIE_DOMAIN=nimbussystems.com.br
NIMBUSNOVAX_COOKIE_SECURE=true
NIMBUSNOVAX_COOKIE_SAMESITE=Lax

NIMBUSNOVAX_RESOURCE_SERVER_ENABLED=true

NIMBUSNOVAX_SPA_BASE_URL=https://novax.nimbussystems.com.br
NIMBUSNOVAX_ALLOWED_ORIGIN=https://novax.nimbussystems.com.br

SPRING_DATASOURCE_URL=jdbc:postgresql://<PGHOST>:<PGPORT>/<PGDATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=<PGUSER>
SPRING_DATASOURCE_PASSWORD=<PGPASSWORD>

# Config de e-mail (com.nimbusnovax.common.notification.mail) - o módulo Voucher já dispara e-mail
# de verdade (troca/vencimento), então em produção usar "api_key" (Brevo) desde o lançamento, não
# "fake" (que só loga, usado em dev antes do Voucher existir). A chave certa é a da aba "API Keys"
# do Brevo (Settings -> SMTP & API), NÃO a aba "SMTP" (mesmo erro cometido no NimbusAuth/CardSync).
# O código mantém fallback "fake" se a env var não for setada (application-prod.yml), então setar
# BREVO_API_KEY é obrigatório pra este deploy enviar e-mail de verdade.
NIMBUSNOVAX_EMAIL_IMPL=api_key
NIMBUSNOVAX_EMAIL_FROM_NAME=NimbusNovax
NIMBUSNOVAX_EMAIL_FROM_EMAIL=naoresponda@nimbussystems.com.br
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=

JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport
